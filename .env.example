# Postgres connection string. On Vercel this is injected by the Neon integration.
DATABASE_URL=postgres://axiom:axiom@localhost:5432/axiom_dev

# The tutor, and the writer of review questions. On Vercel the key is set in the project's environment variables; tests never need it.
# ANTHROPIC_API_KEY=
# Optional: the model, and how hard it thinks (medium, high or xhigh; never low). High is the default.
# AXIOM_TUTOR_MODEL=claude-opus-5-5
# AXIOM_TUTOR_EFFORT=high
